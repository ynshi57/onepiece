            tensor<fp16, [2]> const_33_to_fp16 = const()[name = tensor<string, []>("const_33_to_fp16"), val = tensor<fp16, [2]>([0x1.eccp-11, -0x1.e98p+0])];
            tensor<fp16, [1, 2, 360, 640]> input_cast_fp16 = conv_transpose(bias = const_33_to_fp16, dilations = input_133_dilations_0, groups = input_133_groups_0, output_shape = input_133_has_output_shape_output_shape_0, pad = input_133_pad_0, pad_type = input_133_pad_type_0, strides = input_133_strides_0, weight = const_32_to_fp16, x = input_131_cast_fp16)[name = tensor<string, []>("input_cast_fp16")];
