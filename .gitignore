.venv/
.pytest_cache/
__pycache__/
build/
deploy/logs/
ios-vqa-app/vendor/
ios-vqa-app/.bundle/
ios-vqa-app/.bundle-home/
ios-vqa-app/fastlane/.env
deploy/ios/ExportOptions.plist

# Xcode user-local state and build products
ios-vqa-app/VQASee/**/xcuserdata/**/UserInterfaceState.xcuserstate
ios-vqa-app/VQASee/DerivedData/
ios-vqa-app/VQASee/build/

# Local diagnostic captures may contain user images/metadata; never commit.
server-vqa/diagnostic-captures/

# Optional local Core ML depth model (download via deploy/ios/install_depth_anything_v2_small.sh)
ios-vqa-app/VQASee/VQASee/DepthAnythingV2SmallF16.mlpackage/

# Optional local traversability segmentation model (install via deploy/ios/install_traversability_segmentation_model.sh)
ios-vqa-app/VQASee/VQASee/VQASeeTraversabilitySegmentation.mlmodelc/

# Perception harness (macOS offline evaluation) build artifacts
ios-vqa-app/perception-harness/.build/
ios-vqa-app/perception-harness/.swiftpm-cache/
ios-vqa-app/perception-harness/.swiftpm/

# Runtime perception config store (versioned config is bumped at runtime, not source)
server-vqa/data/perception_config.json

# Server-side offline traversability predictor ONNX model (large binary; not committed).
server-vqa/models/
