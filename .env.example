# Shared by relay, worker, and iOS app relay settings.
# Replace with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
RELAY_PAIRING_TOKEN=dev-pairing-token

# Relay server
HOST=0.0.0.0
PORT=9100
MAX_FRAME_BASE64_BYTES=900000
MAX_FRAMES_PER_MINUTE=30
MAX_INFLIGHT_PER_CLIENT=1
RELAY_REQUEST_TIMEOUT_SECONDS=30

# Local worker
RELAY_WORKER_URL=ws://127.0.0.1:9100/ws/worker
WORKER_ID=local-mac-worker
WORKER_INFERENCE_TIMEOUT_SECONDS=20
WORKER_DROP_IF_BUSY=1

# Optional local Qwen/Ollama inference
QWEN_API_BASE_URL=http://127.0.0.1:11434
QWEN_MODEL=qwen2.5vl:3b
# Optional higher-quality local model. Pull first with:
# MODEL=qwen2.5vl:7b bash ./start_qwen_local.sh
# QWEN_MODEL=qwen2.5vl:7b

# Nearby/hotspot Bonjour discovery
VQASEE_DISABLE_BONJOUR=0
